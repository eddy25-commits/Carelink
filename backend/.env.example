# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL + PostGIS)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/health_triage
DB_POOL_MIN=2
DB_POOL_MAX=10

# Auth
JWT_SECRET=change-this-to-a-long-random-secret
JWT_EXPIRES_IN=8h

# Report tokens (used by anonymous/community reporters to check status, no login needed)
REPORT_TOKEN_LENGTH=10

# SLA monitor / incident clustering cron
SLA_MONITOR_CRON=*/5 * * * *
INCIDENT_CLUSTER_CRON=*/15 * * * *
INCIDENT_CLUSTER_RADIUS_METERS=1500
INCIDENT_CLUSTER_MIN_REPORTS=3
INCIDENT_CLUSTER_WINDOW_HOURS=72

# Notifications (stub "log" provider by default; swap for a real SMS/push gateway later)
NOTIFICATION_PROVIDER=log

# Report attachments (photos / PDFs a reporter attaches as evidence)
UPLOAD_DIR=uploads
MAX_ATTACHMENT_SIZE_MB=5
MAX_ATTACHMENTS_PER_REPORT=3

# Error tracking (optional — leave blank to log locally only)
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Prometheus-style metrics at GET /metrics (off by default)
METRICS_ENABLED=false
